# =============================================================================
# Plantilla de variables de entorno: copiar a .env y poner los valores reales.
#
# Este archivo SI se versiona; .env NO. Lo carga Spring Boot por
# 'spring.config.import' en application.properties.
#
# Formato de archivo .properties, NO de script de shell:
#   - sin 'export'
#   - sin comillas alrededor del valor (quedarian DENTRO de la contrasena)
#   - el valor va literal hasta el fin de linea
# =============================================================================

IKERNELL_DB_HOST=localhost
IKERNELL_DB_PUERTO=5432
IKERNELL_DB_NOMBRE=ikernell
IKERNELL_DB_USUARIO=ikernell
IKERNELL_DB_PASSWORD=cambiar-esta-clave

# Tamano del pool de conexiones (ver application.properties).
IKERNELL_DB_POOL_MAXIMO=10
IKERNELL_DB_POOL_MINIMO=2
