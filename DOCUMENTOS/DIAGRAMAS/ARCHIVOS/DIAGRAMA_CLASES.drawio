  <diagram name="Página-1" id="6tkk7M7e9E0jsGRjk8OE">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\nclass Trabajador {\n  -Long id\n  -String identificacion\n  -String nombre\n  -String apellido\n  -Date fechaNacimiento\n  -String direccion\n  -String profesion\n  -String especialidadDesarrollo\n  -String tipoTrabajador\n  -String estado\n  -String fotoRuta\n  -String fotoContentType\n  -Long fotoTamanoBytes\n  -String fotoIdentificacion\n  +inhabilitar() void\n  +habilitar() void\n  +cambiarEstado(estado) void\n  +asignarFotografia(ruta) void\n}\n\nclass CuentaAcceso {\n  -Long id\n  -String correoCorporativo\n  -String passwordHash\n  -DateTime ultimoAccesoEn\n  +registrarAcceso() void\n  +validarCredenciales(password) boolean\n  +cambiarPassword(nuevoHash) void\n}\n\nclass Proyecto {\n  -Long id\n  -String nombre\n  -String descripcion\n  -String estadoHabilitacion\n  -String estadoOperativo\n  -Long liderId\n  -Date fechaInicioReal\n  -Date fechaFinReal\n  -Boolean reporteExternoAutorizado\n  -DateTime fechaCreacion\n  -String estadoLiderazgo\n  +crear() void\n  +modificar() void\n  +inhabilitar() void\n  +rehabilitar() void\n}\n\nclass Rol {\n  -Long id\n  -String nombreRol\n  +consultarRol() String\n}\n\nclass RolTrabajador {\n  -Long id\n  -Boolean activa\n  -Long asignadaPorId\n  -Date fechaAsignacion\n  -Decimal dedicacionPorcentaje\n  -String estadoLiderazgo\n  +asignarTrabajador() void\n  +desactivarAsignacion() void\n}\n\nclass Etapa {\n  -Long id\n  -String nombre\n  -String descripcion\n  -Integer orden\n  +crear() void\n  +modificar() void\n}\n\nclass Actividad {\n  -Long id\n  -String descripcion\n  -String estado\n  -String prioridad\n  -Date fechaPlanificada\n  +registrar() void\n  +modificar() void\n  +cambiarEstado() void\n}\n\nclass EjecucionActividad {\n  -Long id\n  -DateTime iniciadaEn\n  -DateTime finalizadaEn\n  +iniciar() void\n  +finalizar() void\n}\n\nclass ErrorProyecto {\n  -Long id\n  -String tipoError\n  -String descripcion\n  -Date fecha\n  -String faseHistorica\n  +registrar() void\n  +consultar() void\n}\n\nclass InterrupcionProyecto {\n  -Long id\n  -String tipoInterrupcion\n  -Date fecha\n  -Decimal duracionValor\n  -String duracionUnidad\n  -String faseHistorica\n  +registrar() void\n  +calcularDuracion() Decimal\n}\n\nclass ConsultaPublica {\n  -Long id\n  -String pregunta\n  -String nombreContacto\n  -String correoContacto\n  -String telefonoContacto\n  -DateTime recibidaEn\n  -Boolean atendida\n  -Long atendidaPorId\n  -String estado\n  -DateTime fechaRespuesta\n  +registrar() void\n  +atender() void\n}\n\nclass RespuestaConsulta {\n  -Long id\n  -String contenido\n  -DateTime fechaRespuesta\n  -Boolean enviadaPorCorreo\n  -String detalleError\n  +responder() void\n}\n\nclass HiloConversacion {\n  -Long id\n  -String titulo\n  -DateTime creadoEn\n  +crearHilo() void\n  +consultarMensajes() void\n}\n\nclass MensajeHilo {\n  -Long id\n  -String cuerpo\n  -DateTime enviadoEn\n  +enviarMensaje() void\n}\n\nclass LecturaHilo {\n  -Long id\n  -DateTime leidoHasta\n  +registrarLectura() void\n}\n\nclass TrabajadorHabilidad {\n  -Long id\n  -String categoria\n  -String nombre\n  +registrarHabilidad() void\n  +modificarHabilidad() void\n}\n\nclass TareaMiDia {\n  -Long id\n  -String descripcion\n  -Date fecha\n  -Boolean completada\n  -DateTime creadaEn\n  +crearTarea() void\n  +marcarCompletada() void\n}\n\n%% Relaciones principales\n\nTrabajador \&quot;1\&quot; -- \&quot;1\&quot; CuentaAcceso : tiene\n\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; RolTrabajador : recibe\nProyecto \&quot;1\&quot; -- \&quot;0..*\&quot; RolTrabajador : contiene\nRol \&quot;1\&quot; -- \&quot;0..*\&quot; RolTrabajador : define\n\nProyecto \&quot;1\&quot; -- \&quot;1..*\&quot; Etapa : contiene\nEtapa \&quot;1\&quot; -- \&quot;0..*\&quot; Actividad : agrupa\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; Actividad : desarrolla\n\nActividad \&quot;1\&quot; -- \&quot;0..*\&quot; EjecucionActividad : registra\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; EjecucionActividad : ejecuta\n\nProyecto \&quot;1\&quot; -- \&quot;0..*\&quot; ErrorProyecto : registra\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; ErrorProyecto : reporta\nEtapa \&quot;0..1\&quot; -- \&quot;0..*\&quot; ErrorProyecto : identifica\n\nProyecto \&quot;1\&quot; -- \&quot;0..*\&quot; InterrupcionProyecto : registra\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; InterrupcionProyecto : reporta\nEtapa \&quot;0..1\&quot; -- \&quot;0..*\&quot; InterrupcionProyecto : identifica\n\nConsultaPublica \&quot;1\&quot; -- \&quot;0..*\&quot; RespuestaConsulta : recibe\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; RespuestaConsulta : responde\n\nProyecto \&quot;1\&quot; -- \&quot;0..*\&quot; HiloConversacion : contiene\nEtapa \&quot;0..1\&quot; -- \&quot;0..*\&quot; HiloConversacion : contextualiza\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; HiloConversacion : crea\n\nHiloConversacion \&quot;1\&quot; -- \&quot;0..*\&quot; MensajeHilo : contiene\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; MensajeHilo : escribe\n\nHiloConversacion \&quot;1\&quot; -- \&quot;0..*\&quot; LecturaHilo : registra\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; LecturaHilo : consulta\n\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; TrabajadorHabilidad : posee\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; TareaMiDia : tiene\n\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; Proyecto : lidera\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; RolTrabajador : asigna\nTrabajador \&quot;1\&quot; -- \&quot;0..*\&quot; ConsultaPublica : atiende\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="u4XwRLvgb2rs_L2P4mU0-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
